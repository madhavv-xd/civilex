# ============================================================
# CivilEx — Root .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
.Python
build/
dist/
*.egg-info/
.eggs/
wheels/
MANIFEST
*.so

# ── Virtual environments (uv / venv) ────────────────────────
.venv/
venv/
ENV/
env/
.uv/

# ── Node ────────────────────────────────────────────────────
node_modules/

# ── Next.js build outputs ───────────────────────────────────
.next/
out/
/build
/dist

# ── Environment / secrets ───────────────────────────────────
.env
.env.local
.env.*.local
*.env
!*.env.example

# ── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing / coverage ──────────────────────────────────────
.pytest_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
/coverage
/.nyc_output

# ── Linters / type checkers ─────────────────────────────────
.ruff_cache/
.mypy_cache/

# ── Database files ──────────────────────────────────────────
*.db
*.sqlite3
*.sqlite3-journal

# ── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── IDEs / editors ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── OS generated ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Tool caches ─────────────────────────────────────────────
.codectx_cache/
.codectx-cache/

# ── Vercel ──────────────────────────────────────────────────
.vercel

# ── Yarn ────────────────────────────────────────────────────
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions